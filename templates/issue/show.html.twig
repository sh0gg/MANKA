{% extends 'app/base.html.twig' %}

{% block title %}Incidencia #{{ issue.id }} — MANKA{% endblock %}

{% block content %}
    <a href="{{ path('app_issue_index') }}" class="mb-4.5 inline-flex items-center gap-1.5 text-sm font-medium text-gray-500 hover:text-gray-900">
        <svg class="size-[15px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Volver ás incidencias
    </a>

    <div class="mb-5 flex flex-wrap items-start justify-between gap-3.5">
        <div>
            <h1 class="mb-1.5 text-h1 font-bold text-gray-900">INC-{{ issue.id }} — {{ issue.device.name }}</h1>
            <div class="flex flex-wrap items-center gap-1.5">
                {% if issue.open %}
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-red-50 px-2.5 py-0.5 text-eyebrow font-semibold text-red-600">
                        <span class="size-1.5 animate-pulse rounded-full bg-red-500"></span>
                        Aberta
                    </span>
                {% else %}
                    <span class="inline-flex items-center rounded-full bg-green-50 px-2.5 py-0.5 text-eyebrow font-semibold text-green-600">Pechada</span>
                {% endif %}

                {% if issue.type.value == 'preventivo' %}
                    <span class="inline-flex items-center rounded-full bg-blue-50 px-2.5 py-0.5 text-eyebrow font-semibold text-blue-600">Preventivo</span>
                {% else %}
                    <span class="inline-flex items-center rounded-full bg-orange-50 px-2.5 py-0.5 text-eyebrow font-semibold text-orange-600">Correctivo</span>
                {% endif %}

                <span class="text-meta text-gray-400">Aberta o {{ issue.startAt|date('d/m/Y \\á\\s H:i') }}</span>
            </div>
        </div>

        <div class="flex shrink-0 flex-wrap gap-1.5">
            {% if is_granted('ISSUE_EDIT', issue) %}
                <a href="{{ path('app_issue_edit', {id: issue.id}) }}"
                   class="inline-flex items-center rounded-lg border border-gray-300 bg-white px-3.5 py-2 text-sm font-semibold text-gray-700 transition hover:bg-gray-50">Editar</a>
            {% endif %}

            {% if is_granted('ISSUE_DELETE', issue) %}
                <form method="post" action="{{ path('app_issue_delete', {id: issue.id}) }}" onsubmit="return confirm('Eliminar esta incidencia? Esta acción non se pode desfacer.');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ issue.id) }}">
                    <button type="submit" class="inline-flex items-center rounded-lg bg-red-50 px-3 py-2 text-sm font-semibold text-red-600 transition hover:bg-red-100">Eliminar</button>
                </form>
            {% endif %}

            {% if issue.open and is_granted('ISSUE_CLOSE', issue) %}
                <form method="post" action="{{ path('app_issue_close', {id: issue.id}) }}" class="flex flex-wrap items-center gap-2.5">
                    <input type="hidden" name="_token" value="{{ csrf_token('close' ~ issue.id) }}">
                    <label class="flex items-center gap-1.5 text-meta font-medium text-gray-600">
                        <input type="checkbox" name="hygieneCheckDone" value="1" class="size-3.5 rounded border-gray-300 text-brand focus:ring-brand-light">
                        Hixiene verificada
                    </label>
                    <button type="submit" class="inline-flex items-center rounded-lg bg-brand px-3.5 py-2 text-sm font-semibold text-white transition hover:bg-brand-hover">Pechar incidencia</button>
                </form>
            {% endif %}
        </div>
    </div>

    <div class="grid grid-cols-1 gap-4.5 lg:grid-cols-3">
        {# Datos da incidencia #}
        <div class="rounded-xl border border-gray-200 bg-white lg:col-span-1">
            <div class="border-b border-gray-100 px-5 py-3 text-eyebrow font-bold tracking-wide text-gray-500 uppercase">Datos da incidencia</div>
            <div class="grid grid-cols-2 gap-x-4 gap-y-3.5 px-5 py-4">
                <div>
                    <div class="mb-0.5 text-eyebrow font-semibold tracking-wide text-gray-400 uppercase">Equipo</div>
                    <div class="text-sm font-medium text-gray-900">{{ issue.device.name }}</div>
                </div>
                <div>
                    <div class="mb-0.5 text-eyebrow font-semibold tracking-wide text-gray-400 uppercase">Categoría</div>
                    <div class="text-sm font-medium text-gray-900">{{ issue.category.name }}</div>
                </div>
                <div>
                    <div class="mb-0.5 text-eyebrow font-semibold tracking-wide text-gray-400 uppercase">Tipo</div>
                    <div class="text-sm font-medium text-gray-900">{{ issue.type.label }}</div>
                </div>
                <div>
                    <div class="mb-0.5 text-eyebrow font-semibold tracking-wide text-gray-400 uppercase">Inicio</div>
                    <div class="text-sm font-medium text-gray-900">{{ issue.startAt|date('d/m/Y H:i') }}</div>
                </div>
                <div>
                    <div class="mb-0.5 text-eyebrow font-semibold tracking-wide text-gray-400 uppercase">Fin</div>
                    <div class="text-sm font-medium {{ issue.endAt ? 'text-gray-900' : 'text-gray-400' }}">{{ issue.endAt ? issue.endAt|date('d/m/Y H:i') : '—' }}</div>
                </div>
                {% if not issue.open %}
                    <div>
                        <div class="mb-0.5 text-eyebrow font-semibold tracking-wide text-gray-400 uppercase">Hixiene</div>
                        {% if issue.hygieneCheckDone %}
                            <span class="inline-flex items-center rounded-full bg-green-50 px-2.5 py-0.5 text-eyebrow font-semibold text-green-600">Verificada</span>
                        {% else %}
                            <span class="inline-flex items-center rounded-full bg-amber-50 px-2.5 py-0.5 text-eyebrow font-semibold text-amber-600">Sen verificar</span>
                        {% endif %}
                    </div>
                {% endif %}
                <div class="col-span-2">
                    <div class="mb-0.5 text-eyebrow font-semibold tracking-wide text-gray-400 uppercase">Técnicos asignados</div>
                    <div class="text-sm font-medium {{ issue.technicians|length > 0 ? 'text-gray-900' : 'text-gray-400' }}">
                        {{ issue.technicians|length > 0 ? issue.technicians|map(t => t.fullName)|join(', ') : 'Sen asignar' }}
                    </div>
                </div>
                <div class="col-span-2">
                    <div class="mb-0.5 text-eyebrow font-semibold tracking-wide text-gray-400 uppercase">Reportado por</div>
                    <div class="flex items-center gap-1.5 text-sm font-medium text-gray-900">
                        {{ issue.createdBy.fullName }}
                        {{ include('_components/role_badge.html.twig', {user: issue.createdBy}) }}
                    </div>
                </div>
            </div>
        </div>

        {# Observacións #}
        <div class="rounded-xl border border-gray-200 bg-white lg:col-span-2">
            <div class="border-b border-gray-100 px-5 py-3 text-eyebrow font-bold tracking-wide text-gray-500 uppercase">Observacións</div>
            <div class="px-4.5 py-4">
                <div class="flex flex-col gap-3">
                    {% for observation in issue.observations %}
                        <div class="flex gap-2.5">
                            {{ include('_components/avatar.html.twig', {user: observation.author, size: 30}) }}
                            <div class="flex-1 rounded-r-lg rounded-bl-lg border border-gray-200 bg-gray-50 px-3.5 py-2.5">
                                <div class="mb-0.5 flex flex-wrap items-center gap-1.5">
                                    <span class="text-meta font-semibold text-gray-900">{{ observation.author.fullName }}</span>
                                    {{ include('_components/role_badge.html.twig', {user: observation.author}) }}
                                    <span class="text-eyebrow text-gray-400">{{ observation.createdAt|date('d/m H:i') }}</span>
                                </div>
                                <div class="text-sm leading-relaxed text-gray-700">{{ observation.content }}</div>
                            </div>
                        </div>
                    {% else %}
                        <p class="text-sm text-gray-400">Aínda non hai observacións.</p>
                    {% endfor %}
                </div>

                {% if is_granted('ISSUE_ADD_OBSERVATION', issue) %}
                    <form method="post" action="{{ path('app_issue_add_observation', {id: issue.id}) }}" class="mt-4 flex flex-col gap-2 border-t border-gray-100 pt-4">
                        <input type="hidden" name="_token" value="{{ csrf_token('observation' ~ issue.id) }}">
                        <textarea name="content" rows="3" required placeholder="Engade unha observación..."
                                  class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm text-gray-900 outline-none focus:border-brand-light focus:ring-3 focus:ring-brand-light/10"></textarea>
                        <button type="submit" class="self-end rounded-lg bg-brand px-3.5 py-1.5 text-sm font-semibold text-white transition hover:bg-brand-hover">Enviar</button>
                    </form>
                {% elseif not issue.open %}
                    <p class="mt-3 text-meta text-gray-400">A incidencia está pechada: non se poden engadir novas observacións.</p>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
