{% extends 'app/base.html.twig' %}

{% block title %}Nova incidencia — MANKA{% endblock %}

{% block content %}
    <a href="{{ path('app_issue_index') }}" class="mb-4.5 inline-flex items-center gap-1.5 text-sm font-medium text-gray-500 hover:text-gray-900">
        <svg class="size-[15px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Volver ás incidencias
    </a>

    <h1 class="mb-0.5 text-h1 font-bold text-gray-900">Nova incidencia</h1>
    <p class="mb-5 text-sm text-gray-500">Rexistra un novo problema de mantemento</p>

    <div class="max-w-2xl rounded-xl border border-gray-200 bg-white">
        <div class="border-b border-gray-100 px-5 py-3 text-[0.72rem] font-bold tracking-wide text-gray-500 uppercase">Información básica</div>
        <div class="px-5 py-5">
            {{ include('issue/_form.html.twig', {form: form, button_label: 'Gardar incidencia'}) }}
        </div>
    </div>
{% endblock %}
