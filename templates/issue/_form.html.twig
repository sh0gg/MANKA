{{ form_start(form) }}
    {% set global_errors = form_errors(form) %}
    {% if global_errors|length > 0 %}
        <div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            {{ global_errors }}
        </div>
    {% endif %}
    <div class="grid grid-cols-1 gap-x-4 sm:grid-cols-2">
        {{ form_row(form.device) }}
        {{ form_row(form.category) }}
    </div>
    <div class="grid grid-cols-1 gap-x-4 sm:grid-cols-2">
        {{ form_row(form.type) }}
        {{ form_row(form.startAt) }}
    </div>

    {% if form.technicians is defined %}
        <hr class="my-5 border-gray-100">
        <div class="mb-3.5 text-[0.72rem] font-bold tracking-wide text-gray-500 uppercase">Persoal técnico</div>
        {{ form_row(form.technicians) }}
    {% endif %}

    {% if form.initialObservation is defined %}
        <hr class="my-5 border-gray-100">
        <div class="mb-3.5 text-[0.72rem] font-bold tracking-wide text-gray-500 uppercase">Observación inicial</div>
        {{ form_row(form.initialObservation) }}
    {% endif %}

    <div class="mt-2 flex justify-end gap-2">
        <a href="{{ path('app_issue_index') }}" class="inline-flex items-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 transition hover:bg-gray-50">Cancelar</a>
        <button type="submit" class="inline-flex items-center rounded-lg bg-brand px-4 py-2 text-sm font-semibold text-white transition hover:bg-brand-hover">{{ button_label|default('Gardar incidencia') }}</button>
    </div>
{{ form_end(form) }}
