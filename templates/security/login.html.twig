{% extends 'base.html.twig' %}

{% block title %}Acceder — MANKA{% endblock %}

{% block body %}
<div class="flex min-h-full flex-col lg:flex-row">

    {# Panel esquerdo: marca #}
    <div class="relative flex min-h-[220px] w-full flex-col items-center justify-center overflow-hidden bg-brand px-8 py-12 lg:min-h-screen lg:w-[45%]">
        <div class="absolute -top-24 -right-24 size-96 rounded-full bg-white/5"></div>
        <div class="absolute -bottom-20 -left-16 size-72 rounded-full bg-white/5"></div>

        <div class="relative z-10 flex flex-col items-center gap-4 text-center">
            {{ include('_components/logo.html.twig', {size: 64, class: 'text-white'}) }}
            <div class="text-3xl font-bold tracking-widest text-white lg:text-4xl">MANKA</div>
            <p class="max-w-[260px] text-sm leading-relaxed text-white/60">
                Sistema de xestión de incidencias de mantemento industrial
            </p>
        </div>
    </div>

    {# Panel dereito: formulario #}
    <div class="flex flex-1 items-center justify-center bg-slate-100 px-5 py-10 lg:px-12">
        <div class="w-full max-w-sm">
            <h1 class="mb-1.5 text-2xl font-bold text-gray-900">Benvido de volta</h1>
            <p class="mb-8 text-sm leading-relaxed text-gray-500">Accede coas túas credenciais de empresa</p>

            {% if error %}
                <div class="mb-5 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
                    Email ou contrasinal incorrectos.
                </div>
            {% endif %}

            <form method="post">
                <div class="mb-4">
                    <label for="email" class="mb-1.5 block text-sm font-medium text-gray-700">Correo electrónico</label>
                    <input type="email" id="email" name="_username" value="{{ last_username }}" autocomplete="email" required
                           placeholder="usuario@empresa.com"
                           class="w-full rounded-lg border border-gray-300 px-3.5 py-2.5 text-sm text-gray-900 outline-none transition focus:border-brand-light focus:ring-3 focus:ring-brand-light/15">
                </div>
                <div class="mb-4">
                    <label for="password" class="mb-1.5 block text-sm font-medium text-gray-700">Contrasinal</label>
                    <input type="password" id="password" name="_password" autocomplete="current-password" required
                           placeholder="••••••••"
                           class="w-full rounded-lg border border-gray-300 px-3.5 py-2.5 text-sm text-gray-900 outline-none transition focus:border-brand-light focus:ring-3 focus:ring-brand-light/15">
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit"
                        class="mt-1.5 w-full rounded-lg bg-brand py-2.5 text-sm font-semibold text-white transition hover:bg-brand-hover">
                    Acceder
                </button>
            </form>

            <p class="mt-8 text-center text-xs text-gray-400">
                Desenvolvido por <span class="font-semibold text-brand-light">Galicloud S. Coop. Galega</span>
            </p>
        </div>
    </div>
</div>
{% endblock %}
