{% extends 'app/base.html.twig' %}

{% block title %}API Tokens — MANKA{% endblock %}

{% block content %}
    <div class="mb-6 flex items-start justify-between gap-3">
        <div>
            <h1 class="text-[1.3rem] font-bold text-gray-900">API Tokens</h1>
            <p class="mt-0.5 text-sm text-gray-500">Tokens de acceso para integracións externas</p>
        </div>
        <a href="{{ path('app_admin_token_new') }}"
           class="inline-flex items-center gap-1.5 rounded-lg bg-brand px-4 py-2 text-sm font-semibold text-white transition hover:bg-brand-hover">
            <svg class="size-[14px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14" stroke-linecap="round"/></svg>
            Novo token
        </a>
    </div>

    {% for tokenValue in app.flashes('token_created') %}
        <div class="mb-5 rounded-xl border border-amber-200 bg-amber-50 px-5 py-4">
            <p class="mb-2 text-sm font-semibold text-amber-800">Token xerado. Cópiao agora: non se volverá amosar completo.</p>
            <div class="flex items-center justify-between gap-2 rounded-lg border border-amber-200 bg-white px-3.5 py-2.5">
                <code class="break-all font-mono text-[0.8rem] text-gray-700">{{ tokenValue }}</code>
                <button type="button" data-controller="clipboard" data-clipboard-text-value="{{ tokenValue }}" data-action="clipboard#copy"
                        class="shrink-0 rounded-lg border border-gray-300 px-2.5 py-1 text-[0.78rem] font-semibold text-gray-700 transition hover:bg-gray-50">Copiar</button>
            </div>
        </div>
    {% endfor %}

    <div class="flex flex-col gap-3.5">
        {% for token in tokens %}
            <div class="rounded-xl border border-gray-200 bg-gray-50 px-4.5 py-4.5">
                <div class="mb-2.5 flex items-center justify-between">
                    <span class="text-[0.88rem] font-semibold text-gray-900">{{ token.name }}</span>
                    {% if token.valid %}
                        <span class="inline-flex items-center rounded-full bg-green-50 px-2.5 py-0.5 text-[0.72rem] font-semibold text-green-600">Activo</span>
                    {% else %}
                        <span class="inline-flex items-center rounded-full bg-gray-200 px-2.5 py-0.5 text-[0.72rem] font-semibold text-gray-500">Inactivo</span>
                    {% endif %}
                </div>
                <div class="mb-2 flex items-center justify-between gap-2 rounded-lg border border-gray-200 bg-white px-3 py-1.5">
                    <code class="truncate font-mono text-[0.78rem] text-gray-500">{{ token.token|slice(0, 24) }}…</code>
                    <button type="button" data-controller="clipboard" data-clipboard-text-value="{{ token.token }}" data-action="clipboard#copy"
                            class="shrink-0 rounded-lg border border-gray-300 bg-white px-2.5 py-1 text-[0.78rem] font-semibold text-gray-700 transition hover:bg-gray-50">Copiar</button>
                </div>
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <div class="flex flex-wrap gap-3.5 text-[0.72rem] text-gray-400">
                        <span>Creado: {{ token.createdAt|date('d/m/Y') }}</span>
                        <span>{{ token.expiresAt ? 'Expira: ' ~ token.expiresAt|date('d/m/Y') : 'Sen caducidade' }}</span>
                        <span>{{ token.lastUsedAt ? 'Último uso: ' ~ token.lastUsedAt|date('d/m/Y H:i') : 'Sen uso' }}</span>
                    </div>
                    {% if token.active %}
                        <form method="post" action="{{ path('app_admin_token_revoke', {id: token.id}) }}" onsubmit="return confirm('Revogar este token? As aplicacións que o usen deixarán de poder acceder á API.');">
                            <input type="hidden" name="_token" value="{{ csrf_token('revoke' ~ token.id) }}">
                            <button type="submit" class="rounded-lg bg-red-50 px-2.5 py-1 text-[0.78rem] font-semibold text-red-600 transition hover:bg-red-100">Revogar</button>
                        </form>
                    {% endif %}
                </div>
            </div>
        {% else %}
            <p class="py-8 text-center text-sm text-gray-400">Non hai tokens xerados.</p>
        {% endfor %}
    </div>
{% endblock %}
