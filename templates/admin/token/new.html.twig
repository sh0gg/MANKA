{% extends 'app/base.html.twig' %}

{% block title %}Novo token — MANKA{% endblock %}

{% block content %}
    <a href="{{ path('app_admin_token_index') }}" class="mb-4.5 inline-flex items-center gap-1.5 text-sm font-medium text-gray-500 hover:text-gray-900">
        <svg class="size-[15px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Volver a API Tokens
    </a>
    <h1 class="mb-0.5 text-[1.3rem] font-bold text-gray-900">Novo token</h1>
    <p class="mb-5 text-sm text-gray-500">O valor do token só se mostra completo unha vez, ao crealo</p>

    <div class="max-w-lg rounded-xl border border-gray-200 bg-white px-5 py-5">
        {{ form_start(form) }}
            {% set global_errors = form_errors(form) %}
            {% if global_errors|length > 0 %}
                <div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">{{ global_errors }}</div>
            {% endif %}
            {{ form_row(form.name) }}
            {{ form_row(form.expiresAt) }}
            <div class="mt-2 flex justify-end gap-2">
                <a href="{{ path('app_admin_token_index') }}" class="inline-flex items-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 transition hover:bg-gray-50">Cancelar</a>
                <button type="submit" class="inline-flex items-center rounded-lg bg-brand px-4 py-2 text-sm font-semibold text-white transition hover:bg-brand-hover">Xerar token</button>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
